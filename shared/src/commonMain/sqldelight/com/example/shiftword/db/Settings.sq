import kotlin.Boolean;

-- Single-row key-value settings table (id is always 0) — matches the minimal scope of Phase 7's
-- settings screen (sound on/off only); a real multi-key settings store can replace this later
-- if more preferences are added.
--
-- Phase 9 added `language`. SettingsRepository reads the current row and re-writes both columns
-- together (rather than an SQL upsert) -- the default SqlDelight dialect here (sqlite_3_18)
-- doesn't support `ON CONFLICT DO UPDATE`, and a plain `INSERT OR REPLACE` with only one column
-- named would silently reset the other column back to its default every time.
--
-- Feature 1B: opt-in, off-by-default drag-time win highlight (GAME_DESIGN.md) -- a real
-- difficulty lever, not cosmetic, so it must default to 0 like every other assist would.
--
-- Feature 3: hint economy. hintCredits is a GLOBAL pool (not per-level, not per-language) --
-- spending it in one level or starting a new one must not refill it; only a genuine cold start
-- does (see SettingsRepository.refillHintCredits / AppNavHost).
--
-- NOTE: winHighlightEnabled and hintCredits both shipped without a matching migration in their
-- original commits, crashing any already-installed device ("no such column") -- see 1.sqm, which
-- retroactively fixes this for existing installs. Any FUTURE column added here must ship its own
-- migration file in the same commit, not rely on this note as a substitute.
--
-- reducedMotionEnabled / darkModeEnabled: accessibility/appearance settings (GAME_DESIGN.md,
-- ARCHITECTURE.md §7a) -- both default 0/off so the existing animated, light-themed experience is
-- unchanged for players who never open Settings. Shipped WITH their migration (3.sqm) in the same
-- commit, per the note above.
--
-- hasSeenOnboarding (GAME_DESIGN.md §9h): a one-time, first-install-only flag -- not re-triggerable
-- from Settings, no "replay onboarding" option. Defaults 0/false so a brand-new install always
-- sees the onboarding experience once; every existing row this migrates (any pre-onboarding
-- install) also lands on the DEFAULT (false) via 6.sqm, which is a deliberate, harmless side
-- effect discussed in that migration's own comment, not an oversight.
CREATE TABLE settings (
    id INTEGER NOT NULL PRIMARY KEY,
    soundEnabled INTEGER AS Boolean NOT NULL DEFAULT 1,
    language TEXT NOT NULL DEFAULT 'tr',
    winHighlightEnabled INTEGER AS Boolean NOT NULL DEFAULT 0,
    hintCredits INTEGER NOT NULL DEFAULT 3,
    reducedMotionEnabled INTEGER AS Boolean NOT NULL DEFAULT 0,
    darkModeEnabled INTEGER AS Boolean NOT NULL DEFAULT 0,
    hasSeenOnboarding INTEGER AS Boolean NOT NULL DEFAULT 0
);

selectSettings:
SELECT * FROM settings WHERE id = 0;

upsertSettings:
INSERT OR REPLACE INTO settings(id, soundEnabled, language, winHighlightEnabled, hintCredits, reducedMotionEnabled, darkModeEnabled, hasSeenOnboarding) VALUES (0, ?, ?, ?, ?, ?, ?, ?);
