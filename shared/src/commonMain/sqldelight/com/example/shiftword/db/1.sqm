import kotlin.Boolean;

-- Migration from schema v1 (id, soundEnabled, language) to v2. Without this, an app already
-- installed on a device (settings row created under the old schema) crashes on launch with
-- "no such column: settings.winHighlightEnabled" -- AndroidSqliteDriver only runs
-- WordShiftDatabase.Schema.create() on a brand-new DB file; an existing on-device DB is only ever
-- brought up to date by Schema.migrate(), which only runs when a .sqm file actually bumps the
-- schema version. Reproduced on a physical Samsung SM device: FATAL EXCEPTION in
-- SettingsRepository.currentRow() at app launch, via AppNavHost's cold-start hint-credit refill.
ALTER TABLE settings ADD COLUMN winHighlightEnabled INTEGER AS Boolean NOT NULL DEFAULT 0;
